##############################################################################
# Raya Tender — Environment Configuration
# Salin file ini ke .env lalu isi sesuai environment Anda.
#
# PRODUCTION: APP_ENV=production, APP_DEBUG=false, APP_KEY wajib diisi
# DEVELOPMENT: APP_ENV=local, APP_DEBUG=true
##############################################################################

# ============================================================
# Application
# ============================================================
APP_NAME="Raya Tender"
APP_ENV=production
APP_KEY=                          # php artisan key:generate
APP_DEBUG=false
APP_URL=https://domain-anda.com   # Ganti dengan URL production

# Timezone — gunakan Asia/Jakarta untuk WIB
# Scheduler reminders:generate berjalan berdasarkan timezone ini
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# ============================================================
# Security
# ============================================================
# Tingkatkan bcrypt rounds di production untuk keamanan password
BCRYPT_ROUNDS=12

# ============================================================
# Logging
# ============================================================
# Production: gunakan 'daily' agar log tidak tumbuh tak terbatas
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error               # Production: error | Development: debug

# ============================================================
# Database — MySQL
# ============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=raya_tender
DB_USERNAME=raya_user          # Jangan gunakan 'root' di production
DB_PASSWORD=                   # Isi dengan password yang kuat

# ============================================================
# Session
# ============================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120            # Menit — sesuaikan kebutuhan
SESSION_ENCRYPT=true            # Wajib true di production
SESSION_PATH=/
SESSION_DOMAIN=null             # Isi dengan domain jika multi-subdomain

# ============================================================
# Cache
# ============================================================
CACHE_STORE=file
# CACHE_PREFIX=raya_tender_

# ============================================================
# Queue
# ============================================================
# sync: eksekusi langsung (cukup untuk RAKTAMS saat ini)
# database/redis: untuk background job jika diperlukan
QUEUE_CONNECTION=sync

# ============================================================
# Filesystem
# ============================================================
# Dokumen tender/proposal disimpan di disk 'private' (non-public)
# Pastikan storage/app writable: chmod -R 775 storage
FILESYSTEM_DISK=local

# ============================================================
# Mail (opsional — untuk notifikasi email di masa depan)
# ============================================================
MAIL_MAILER=log                 # Ganti ke smtp/mailgun untuk production
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# Broadcast (tidak digunakan saat ini)
# ============================================================
BROADCAST_CONNECTION=log

# ============================================================
# Redis (opsional — aktifkan jika hosting support Redis)
# ============================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================
# AWS S3 (opsional — untuk file storage cloud)
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================
# Vite
# ============================================================
VITE_APP_NAME="${APP_NAME}"

##############################################################################
# CATATAN DEPLOYMENT
##############################################################################
#
# 1. Salin file ini: cp .env.example .env
# 2. Generate key: php artisan key:generate
# 3. Isi DB_PASSWORD dengan password yang kuat
# 4. Jalankan migrasi: php artisan migrate --force
# 5. Seed permissions: php artisan db:seed --class=RolePermissionSeeder
# 6. Build assets: npm ci && npm run build
# 7. Optimize: php artisan optimize
# 8. Set permission folder:
#    chmod -R 775 storage bootstrap/cache
#    chown -R www-data:www-data storage bootstrap/cache
#
# 9. Tambahkan ke crontab untuk scheduler (deadline reminders):
#    * * * * * cd /path/to/raya-tender && php artisan schedule:run >> /dev/null 2>&1
#
# 10. Pastikan APP_DEBUG=false dan SESSION_ENCRYPT=true di production
#
##############################################################################
